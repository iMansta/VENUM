{
  "name": "albion-arbitrage-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-celeste-pack.mjs && node node_modules/vite/bin/vite.js build",
    "celeste:pack": "node scripts/build-celeste-pack.mjs",
    "celeste": "node celeste/celeste.mjs",
    "celeste:once": "node celeste/celeste.mjs --once",
    "celeste-d:register": "npm install --prefix celeste-d && node celeste-d/src/register-commands.js",
    "celeste-d:start": "npm install --prefix celeste-d && node celeste-d/src/index.js",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "setup": "node scripts/setup.mjs",
    "catalog:seed": "node scripts/seed-catalog.js",
    "collector": "node scripts/collector/index.mjs",
    "collector:once": "node scripts/collector/index.mjs --once"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
