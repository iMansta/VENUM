# Supabase (Frontend — Vercel)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (Coletor / seed — NUNCA commitar service role no frontend)
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Guilda
GUILD_NAME=I V E N U M I
VITE_GAMEINFO_BASE=https://gameinfo.albiononline.com/api/gameinfo
VITE_ALBION_DATA_BASE=https://west.albion-online-data.com

# Discord Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_MISSIONS=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_EVENTS=https://discord.com/api/webhooks/xxx/yyy

# Coletor (intervalos em ms)
COLLECTOR_INTERVAL_MS=900000
GUILD_SYNC_INTERVAL_MS=86400000

# App
VITE_APP_NAME=I V E N U M I
VITE_APP_URL=http://localhost:3000

VITE_ENABLE_GUILD_HUB=true
VITE_ENABLE_SHOP=true
VITE_ENABLE_MISSIONS=true
